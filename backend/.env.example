# ============================================================
# Backend configuration — copy to backend/.env
# ============================================================

ENVIRONMENT=dev
DEBUG=true
LOG_LEVEL=INFO

# Generate with: openssl rand -hex 32
SECRET_KEY=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Postgres (async driver for the API, sync driver for Celery workers)
# Defaults match a local Docker Postgres: user=postgres password=mysecretpassword
DATABASE_URL=postgresql+asyncpg://postgres:mysecretpassword@localhost:5432/postgres
DATABASE_URL_SYNC=postgresql+psycopg://postgres:mysecretpassword@localhost:5432/postgres
CREATE_ALL_TABLES=true

# Redis (JWT blacklist + SSE pub/sub + Celery broker)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# File uploads
UPLOAD_DIR=./uploads
# Accepted window: MIN_UPLOAD_SIZE_KB <= size < MAX_UPLOAD_SIZE_MB (0 = no cap)
MIN_UPLOAD_SIZE_KB=10
MAX_UPLOAD_SIZE_MB=10

# Ollama AI inference layer
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=hf.co/Qwen/Qwen3-VL-2B-Instruct-GGUF:Q4_K_M
OLLAMA_TIMEOUT_SECONDS=240
OLLAMA_TEMPERATURE=0.1

# CORS (JSON list)
CORS_ORIGINS=["http://localhost:3000"]
