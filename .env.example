# ============================================================
# Medical Prescription Digitizer — development environment
# Copy to `.env` and adjust as needed. Consumed by docker-compose.
# ============================================================

# --- Postgres ---
POSTGRES_USER=mpd
POSTGRES_PASSWORD=mpd
POSTGRES_DB=mpd

# --- Backend (inside compose network) ---
DATABASE_URL=postgresql+asyncpg://mpd:mpd@postgres:5432/mpd
DATABASE_URL_SYNC=postgresql+psycopg://mpd:mpd@postgres:5432/mpd
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ENVIRONMENT=dev
DEBUG=true
CREATE_ALL_TABLES=true
UPLOAD_DIR=/data/uploads
MIN_UPLOAD_SIZE_KB=10
MAX_UPLOAD_SIZE_MB=10
CORS_ORIGINS=["http://localhost:3000"]

# --- Ollama ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3-vl:2b

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
API_URL_INTERNAL=http://backend:8000
AUTH_SECRET=change-me-generate-with-openssl-rand-hex-32
AUTH_TRUST_HOST=true